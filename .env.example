# Copie ce fichier sous le nom .env.local (sur ton ordinateur)
# et colle les mêmes valeurs dans Vercel > Settings > Environment Variables.

# Supabase > Project Settings > API (ou bouton "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique ("Publishable key", commence par sb_publishable_)
# Elle peut être vue dans le navigateur : c'est normal, la RLS protège les données.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Clé SECRÈTE ("Secret key", commence par sb_secret_).
# Utilisée seulement sur le serveur pour vérifier les clés d'accès et créer les comptes.
# Ne JAMAIS la mettre dans une variable NEXT_PUBLIC_, ni sur GitHub.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
